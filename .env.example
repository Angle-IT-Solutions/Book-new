# Database
# Set a stable random value in production; local `pnpm dev` generates one if unset.
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Enable Netlify Database in the site dashboard; it injects NETLIFY_DB_URL.
# Enable Netlify Blobs for the site; its runtime credentials are injected automatically.
SQLITE_URL=file:./payload.db

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Netlify Blobs is enabled automatically by @netlify/blobs in Netlify functions.
